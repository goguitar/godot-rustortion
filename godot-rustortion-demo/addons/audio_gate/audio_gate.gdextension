[configuration]

entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.5

[libraries]

windows.debug.x86_64 = "bin/godot_rustortion.dll"
windows.release.x86_64 = "bin/godot_rustortion.dll"
linux.debug.x86_64 = "bin/libgodot_rustortion.so"
linux.release.x86_64 = "bin/libgodot_rustortion.so"
macos.debug = "bin/libgodot_rustortion.dylib"
macos.release = "bin/libgodot_rustortion.dylib"
